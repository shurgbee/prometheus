# Integrated backend by default. Use the root launcher to share its API token automatically.
NEXT_PUBLIC_USE_MOCKS=false
BACKEND_URL=http://127.0.0.1:8000
# Manual Next.js startup: copy API_TOKEN from the root .env into this SERVER-ONLY variable.
BACKEND_API_TOKEN=
# Set NEXT_PUBLIC_USE_MOCKS=true only for the independent in-browser mock preview.
