# Copy to .env and replace placeholders before running in live mode.
DEMO_MODE=false
ENABLE_DEV_INJECTION=false
API_TOKEN=replace-with-a-strong-random-token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
CHECKPOINT_SQLITE_PATH=./checkpoints.db
CORS_ORIGINS=["http://localhost:3000"]

# Live: DEMO_MODE=false, ENABLE_DEV_INJECTION=false, use a strong API_TOKEN.
# Tiger connection: use postgresql://...?...sslmode=require (normalized by app).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
NVIDIA_API_KEY=
SUPER_BASE_URL=https://integrate.api.nvidia.com/v1
SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NANO_BASE_URL=https://integrate.api.nvidia.com/v1
NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
# For self-hosted NIMs change base URLs/model IDs; endpoints can use separate keys.
NANO_API_KEY=
SUPER_API_KEY=
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBED_API_KEY=
EMBED_DIMENSIONS=2048
FINNHUB_API_KEY=
NOTIFIER_URL=http://127.0.0.1:8001
NOTIFIER_TOKEN=replace-with-a-strong-random-token
ALERT_PHONE=+15555550100
DASHBOARD_URL=http://localhost:3000
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
