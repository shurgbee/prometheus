# Copy to .env and replace placeholders before running in live mode.
DEMO_MODE=false
ENABLE_DEV_INJECTION=false
API_TOKEN=replace-with-a-strong-random-token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
CHECKPOINT_SQLITE_PATH=./checkpoints.db
CORS_ORIGINS=["http://localhost:3000"]

# Live: DEMO_MODE=false, ENABLE_DEV_INJECTION=false, use a strong API_TOKEN.
# Tiger connection: use postgresql://...?...sslmode=require (normalized by app).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# All three use NVIDIA_BASE_URL/NVIDIA_API_KEY unless overridden below.
# For self-hosted NIMs, set per-model endpoints and any separate keys.
SUPER_BASE_URL=
NANO_BASE_URL=
EMBED_BASE_URL=
NANO_API_KEY=
SUPER_API_KEY=
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBED_API_KEY=
EMBED_DIMENSIONS=2048
FINNHUB_API_KEY=
# Alert texts: the backend POSTs to the notifier (notifier/), which texts ALERT_PHONE via Photon.
# ALERT_PHONE: the phone (+15555550123) or Apple ID email you text the Photon line from.
NOTIFIER_URL=http://127.0.0.1:8001
NOTIFIER_TOKEN=
ALERT_PHONE=
DASHBOARD_URL=http://localhost:3000
# Photon project ID (pho_prj_…) and project API key (pho_sk_…) from app.photon.codes.
# Only the notifier reads these. The key needs users, spaces and messages permissions.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Optional: PHOTON_LINE=+1… picks the iMessage line when the project has several.
# Optional: PHOTON_DRY_RUN=true logs texts instead of sending them.
# SMS line: set PHOTON_PLATFORM=sms; calls and SMS need an E.164 ALERT_PHONE distinct from the sender.
# Self-hosted voice deployment: see docs/voice-deployment.md. scripts/configure-voice.py writes .env.voice.
# VOICE_GATEWAY_URL=http://127.0.0.1:8002
# PHOTON_PLATFORM=imessage
# NGC_API_KEY=  # Needed only for the optional NVIDIA Riva profile, not Kokoro.
